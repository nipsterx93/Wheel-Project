phicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontWeight":"Medium","FontSize":35.0,"Text":"IGNITION OFF","TextColor":"#FF000000","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":58.0,"Left":507.0,"Top":80.0,"Visible":false,"BlinkPhasisInverted":false,"Width":266.0,"Name":"IgnitionOff","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"Expression":"[EngineIgnitionOn] == 0"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontWeight":"Medium","FontSize":38.0,"Text":"IGNITION ON","TextColor":"#FF000000","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":58.0,"Left":507.0,"Top":80.0,"Visible":false,"BlinkPhasisInverted":false,"Width":266.0,"Name":"IgnitionOn","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"Expression":"[EngineIgnitionOn] == 1 && [Rpms] < 100"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontWeight":"Medium","FontSize":30.0,"Text":"PIT LIMITER ON","TextColor":"#FF000000","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":58.0,"Left":507.0,"Top":80.0,"Visible":false,"BlinkDelay":400.0,"BlinkPhasisInverted":false,"BlinkEnabled":true,"Width":266.0,"Name":"PitLimiterON","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"Expression":"[PitLimiterOn] == 1"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#00FFFFFF","BorderStyle":{"BorderColor":"#FFFFA500","BorderTop":3,"BorderBottom":6,"BorderLeft":3,"BorderRight":3,"Bindings":{"BorderColor":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"var started = $prop('DataCorePlugin.GameData.EngineStarted') || 0;\r\nvar rpms = $prop('DataCorePlugin.GameData.Rpms') || 0;\r\nvar ignition = $prop('DataCorePlugin.GameData.EngineIgnitionOn') || 0;\r\n\r\n// 1. Motore acceso -> NEON (es. Verde Neon #00FF00)\r\nif (started === 1 || rpms > 100) {\r\n    return '#FFFFA500'; \r\n} \r\n// 2. Quadro acceso -> GIALLO (#FFFF00)\r\nelse if (ignition === 1) {\r\n    return '#FFFF00';   \r\n} \r\n// 3. Quadro spento / All'avvio -> BLU (#FF1E90FF)\r\nelse {\r\n    return '#FF1E90FF'; \r\n}"},"Mode":2}}},"Height":80.0,"Left":0.0,"Top":67.0,"Visible":true,"BlinkPhasisInverted":false,"Width":300.0,"Name":"SessionTimeSquare","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"BackgroundColor":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"var started = $prop('DataCorePlugin.GameData.EngineStarted') || 0;\r\nvar rpms = $prop('DataCorePlugin.GameData.Rpms') || 0;\r\nvar ignition = $prop('DataCorePlugin.GameData.EngineIgnitionOn') || 0;\r\n\r\n// 1. Priorità massima: Motore acceso -> TRASPARENTE\r\nif (started === 1 || rpms > 100) {\r\n    return '#00FFFFFF'; \r\n} \r\n// 2. Quadro acceso e motore spento -> GIALLO\r\nelse if (ignition === 1) {\r\n    return '#FFFF00';   \r\n} \r\n// 3. Quadro spento / Motore spento / Valori a 0 all'avvio -> BLU\r\nelse {\r\n    return '#FF1E90FF'; \r\n}"},"Mode":2},"BorderColor":{"Formula":{"Expression":"if([DataCorePlugin.GameData.EngineStarted] or [DataCorePlugin.GameData.Rpms] > 100, '#FF00E5FF', if([DataCorePlugin.GameData.EngineIgnitionOn], '#FFFF00', '#FF1E90FF'))"},"Mode":2},"BorderStyle.Visible":{"Formula":{"Expression":"[DataCorePlugin.GameData.EngineStarted] or [DataCorePlugin.GameData.Rpms] > 100"},"Mode":2},"BorderStyle.BorderThickness":{"Formula":{"Expression":"if([DataCorePlugin.GameData.EngineStarted] or [DataCorePlugin.GameData.Rpms] > 100, 3, 0)"},"Mode":2},"BorderThickness":{"Formula":{"Expression":"if([DataCorePlugin.GameData.EngineStarted] or [DataCorePlugin.GameData.Rpms] > 100, 3, 0)"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontWeight":"Bold","FontSize":25.0,"Text":"SESSION TIME","TextColor":"#FFB0C4DE","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":25.0,"Left":52.0,"Top":72.0,"Visible":true,"BlinkPhasisInverted":false,"Width":200.0,"Name":"SessionTimeLabel","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"TextColor":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"var started = $prop('DataCorePlugin.GameData.EngineStarted') || 0;\r\nvar rpms = $prop('DataCorePlugin.GameData.Rpms') || 0;\r\n\r\n// 1. Motore acceso (sfondo trasparente / bordo neon) -> Testo Steel Blue (#FFB0C4DE)\r\nif (started === 1 || rpms > 100) {\r\n    return '#FFB0C4DE';\r\n} \r\n// 2. Ignition Off (sfondo blu) o Ignition On (sfondo giallo) -> Testo Nero (#FF000000)\r\nelse {\r\n    return '#FF000000';\r\n}"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontWeight":"Medium","FontSize":36.0,"Text":"--","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":45.0,"Left":0.0,"Top":97.0,"Visible":true,"BlinkPhasisInverted":false,"Width":300.0,"Name":"SessionTimeValue","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"var timeStr = $prop('DataPluginDemo.SimRIG.Session.TimeLeftStr');\r\nif (!timeStr) return \"00:00:00\";\r\n\r\n// Elimina i millesimi prendendo solo la parte prima del punto\r\nvar cleanTime = timeStr.toString().split('.')[0]; \r\n\r\nvar parts = cleanTime.split(':');\r\nvar totalMinutes = parseInt(parts[0], 10) || 0;\r\nvar seconds = parts[1] || '00';\r\n\r\n// Calcola ore e minuti rimanenti\r\nvar hours = Math.floor(totalMinutes / 60);\r\nvar minutes = totalMinutes % 60;\r\n\r\nvar hStr = hours.toString().padStart(2, '0');\r\nvar mStr = minutes.toString().padStart(2, '0');\r\n\r\nreturn hStr + ':' + mStr + ':' + seconds;"},"Mode":2},"TextColor":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"var started = $prop('DataCorePlugin.GameData.EngineStarted') || 0;\r\nvar rpms = $prop('DataCorePlugin.GameData.Rpms') || 0;\r\nvar ignition = $prop('DataCorePlugin.GameData.EngineIgnitionOn') || 0;\r\n\r\n// 1. Motore acceso -> Magenta/Viola (#FFFF00FF)\r\nif (started === 1 || rpms > 100) {\r\n    return '#FFFFA500';\r\n} \r\n// 2. Quadro acceso e motore spento -> Nero (#FF000000)\r\nelse if (ignition === 1) {\r\n    return '#FF000000';\r\n} \r\n// 3. Quadro spento / Standby -> Bianco (#FFFFFFFF)\r\nelse {\r\n    return '#FFFFFFFF';\r\n}"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#00FFFFFF","BorderStyle":{"BorderColor":"#FF40E0D0","BorderTop":3,"BorderBottom":6,"BorderLeft":3,"BorderRight":3,"Bindings":{"BorderColor":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"var started = $prop('DataCorePlugin.GameData.EngineStarted') || 0;\r\nvar rpms = $prop('DataCorePlugin.GameData.Rpms') || 0;\r\nvar ignition = $prop('DataCorePlugin.GameData.EngineIgnitionOn') || 0;\r\n\r\n// 1. Motore acceso -> NEON (es. Verde Neon #00FF00)\r\nif (started === 1 || rpms > 100) {\r\n    return '#FF40E0D0'; \r\n} \r\n// 2. Quadro acceso -> GIALLO (#FFFF00)\r\nelse if (ignition === 1) {\r\n    return '#FFFF00';   \r\n} \r\n// 3. Quadro spento / All'avvio -> BLU (#FF1E90FF)\r\nelse {\r\n    return '#FF1E90FF'; \r\n}"},"Mode":2}}},"Height":80.0,"Left":305.0,"Top":67.0,"Visible":true,"BlinkPhasisInverted":false,"Width":223.0,"Name":"LapsSquare","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"BackgroundColor":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"var started = $prop('DataCorePlugin.GameData.EngineStarted') || 0;\r\nvar rpms = $prop('DataCorePlugin.GameData.Rpms') || 0;\r\nvar ignition = $prop('DataCorePlugin.GameData.EngineIgnitionOn') || 0;\r\n\r\n// 1. Priorità massima: Motore acceso -> TRASPARENTE\r\nif (started === 1 || rpms > 100) {\r\n    return '#00FFFFFF'; \r\n} \r\n// 2. Quadro acceso e motore spento -> GIALLO\r\nelse if (ignition === 1) {\r\n    return '#FFFF00';   \r\n} \r\n// 3. Quadro spento / Motore spento / Valori a 0 all'avvio -> BLU\r\nelse {\r\n    return '#FF1E90FF'; \r\n}"},"Mode":2},"BorderColor":{"Formula":{"Expression":"if([DataCorePlugin.GameData.EngineStarted] or [DataCorePlugin.GameData.Rpms] > 100, '#FFFFA500', if([DataCorePlugin.GameData.EngineIgnitionOn], '#FFFF00', '#FF1E90FF'))"},"Mode":2},"BorderStyle.Visible":{"Formula":{"Expression":"[DataCorePlugin.GameData.EngineStarted] or [DataCorePlugin.GameData.Rpms] > 100"},"Mode":2},"BorderStyle.BorderThickness":{"Formula":{"Expression":"if([DataCorePlugin.GameData.EngineStarted] or [DataCorePlugin.GameData.Rpms] > 100, 3, 0)"},"Mode":2},"BorderThickness":{"Formula":{"Expression":"if([DataCorePlugin.GameData.EngineStarted] or [DataCorePlugin.GameData.Rpms] > 100, 3, 0)"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontWeight":"Bold","FontSize":25.0,"Text":"LAPS","TextColor":"#FFB0C4DE","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":25.0,"Left":343.0,"Top":72.0,"Visible":true,"BlinkPhasisInverted":false,"Width":150.0,"Name":"LapsLabel","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"TextColor":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"var started = $prop('DataCorePlugin.GameData.EngineStarted') || 0;\r\nvar rpms = $prop('DataCorePlugin.GameData.Rpms') || 0;\r\n\r\n// 1. Motore acceso (sfondo trasparente / bordo neon) -> Testo Steel Blue (#FFB0C4DE)\r\nif (started === 1 || rpms > 100) {\r\n    return '#FFB0C4DE';\r\n} \r\n// 2. Ignition Off (sfondo blu) o Ignition On (sfondo giallo) -> Testo Nero (#FF000000)\r\nelse {\r\n    return '#FF000000';\r\n}"},"Mode":2}}},