tem":true,"Font":"DINish","FontSize":35.0,"Text":"REM.LAPS: 15","TextColor":"#FFB0C4DE","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":64.0,"Left":200.0,"Top":2.0,"Visible":true,"BlinkPhasisInverted":false,"Width":246.0,"Name":"RemainingLaps","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"Expression":"'REM.LAPS: ' + [DataPluginDemo.SimRIG.Session.RaceLapsRemaining]"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontSize":35.0,"Text":"FUEL DELTA: ","TextColor":"#FFB0C4DE","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":64.0,"Left":453.0,"Top":2.0,"Visible":true,"BlinkPhasisInverted":false,"Width":210.0,"Name":"FuelDeltaText","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontSize":35.0,"Text":"-15","TextColor":"#FFB0C4DE","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":64.0,"Left":653.0,"Top":2.0,"Visible":true,"BlinkPhasisInverted":false,"Width":100.0,"Name":"FuelDeltaValue","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"Expression":"[DataPluginDemo.SimRIG.Fuel.FuelDelta]"},"Mode":2},"TextColor":{"Formula":{"Expression":"if([DataPluginDemo.SimRIG.Fuel.FuelDelta] < 0, '#FF0000', '#00FF00')"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontSize":35.0,"Text":"POS: 2","TextColor":"#FFB0C4DE","HorizontalAlignment":2,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":64.0,"Left":1126.0,"Top":2.0,"Visible":true,"BlinkPhasisInverted":false,"Width":131.0,"Name":"Position","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"Expression":"'POS: ' + [Position]"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#00FFFFFF","BorderStyle":{"BorderColor":"#FF808080","BorderTop":5},"Height":355.0,"Left":0.0,"Top":66.0,"Visible":true,"BlinkPhasisInverted":false,"Width":639.0,"Name":"TopLeft","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#00FFFFFF","BorderStyle":{"BorderColor":"#FF808080","BorderTop":5},"Height":355.0,"Left":640.0,"Top":66.0,"Visible":true,"BlinkPhasisInverted":false,"Width":639.0,"Name":"TopRight","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0}],"BackgroundColor":"#FF000000","Height":727.0,"Left":-1.0,"Top":-1.0,"Visible":false,"BlinkPhasisInverted":false,"Width":1285.0,"Name":"PIT","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"Expression":"(\r\n  ([DataPluginDemo.PersoSteeringWheelMode] == 'PIT') \r\n \r\n)"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":false,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontWeight":"Bold","FontSize":34.0,"Text":"PIT LIMITER ON","TextColor":"#FF000000","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#FF00D5FF","Height":80.0,"Left":0.0,"Top":67.0,"Visible":false,"BlinkPhasisInverted":false,"Width":1280.0,"Name":"PitLimiterBanner","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"Expression":"[PitLimiterOn] == 1"},"Mode":2},"Text":{"Formula":{"Expression":"'PIT LIMITER ON  -  ' + format([SpeedKmh], '0.0') + ' km/h'"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#00FFFFFF","BorderStyle":{"BorderLeft":3,"BorderRight":3,"Bindings":{"BorderColor":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"var started = $prop('DataCorePlugin.GameData.EngineStarted') || 0;\r\nvar rpms = $prop('DataCorePlugin.GameData.Rpms') || 0;\r\nvar ignition = $prop('DataCorePlugin.GameData.EngineIgnitionOn') || 0;\r\n\r\n// 1. Motore acceso -> NEON (es. Verde Neon #00FF00)\r\nif (started === 1 || rpms > 100) {\r\n    return '#FFFFFFFF'; \r\n} \r\n// 2. Quadro acceso -> GIALLO (#FFFF00)\r\nelse if (ignition === 1) {\r\n    return '#FFFF00';   \r\n} \r\n// 3. Quadro spento / All'avvio -> BLU (#FF1E90FF)\r\nelse {\r\n    return '#FF1E90FF'; \r\n}"},"Mode":2}}},"Height":340.0,"Left":535.0,"Top":150.0,"Visible":true,"BlinkPhasisInverted":false,"Width":210.0,"Name":"RectangleItem2","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"BackgroundColor":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"var started = $prop('DataCorePlugin.GameData.EngineStarted') || 0;\r\nvar rpms = $prop('DataCorePlugin.GameData.Rpms') || 0;\r\nvar ignition = $prop('DataCorePlugin.GameData.EngineIgnitionOn') || 0;\r\n\r\n// 1. Priorità massima: Motore acceso -> TRASPARENTE\r\nif (started === 1 || rpms > 100) {\r\n    return '#00FFFFFF'; \r\n} \r\n// 2. Quadro acceso e motore spento -> GIALLO\r\nelse if (ignition === 1) {\r\n    return '#FFFF00';   \r\n} \r\n// 3. Quadro spento / Motore spento / Valori a 0 all'avvio -> BLU\r\nelse {\r\n    return '#FF1E90FF'; \r\n}"},"Mode":2},"BorderColor":{"Formula":{"Expression":"if([DataCorePlugin.GameData.EngineStarted] or [DataCorePlugin.GameData.Rpms] > 100, '#FFFFFFFF', if([DataCorePlugin.GameData.EngineIgnitionOn], '#FFFF00', '#FF1E90FF'))"},"Mode":2},"BorderStyle.Visible":{"Formula":{"Expression":"[DataCorePlugin.GameData.EngineStarted] or [DataCorePlugin.GameData.Rpms] > 100"},"Mode":2},"BorderStyle.BorderThickness":{"Formula":{"Expression":"if([DataCorePlugin.GameData.EngineStarted] or [DataCorePlugin.GameData.Rpms] > 100, 3, 0)"},"Mode":2},"BorderThickness":{"Formula":{"Expression":"if([DataCorePlugin.GameData.EngineStarted] or [DataCorePlugin.GameData.Rpms] > 100, 3, 0)"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontWeight":"Medium","FontSize":230.0,"Text":"5","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":194.0,"Left":580.75,"Top":206.0,"Visible":true,"BlinkPhasisInverted":false,"Width":118.5,"Name":"Gear","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"Expression":"[Gear]"},"Mode":2},"TextColor":{"Formula":{"Expression":"if([DataCorePlugin.GameData.EngineStarted] or [DataCorePlugin.GameData.Rpms] > 100, '#FFFFFFFF', '#FF000000')"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontWeight":"Medium","FontSize":50.0,"Text":"4320","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":75.0,"Left":545.0,"Top":150.0,"Visible":true,"BlinkPhasisInverted":false,"Width":190.0,"Name":"RPM","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"Expression":"[Rpms]"},"Mode":2},"TextColor":{"Formula":{"Expression":"if([DataCorePlugin.GameData.EngineStarted] or [DataCorePlugin.GameData.Rpms] > 100, '#FFFFFFFF', '#FF000000')"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontWeight":"Medium","FontSize":50.0,"Text":"168","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":70.0,"Left":565.0,"Top":400.0,"Visible":true,"BlinkPhasisInverted":false,"Width":150.0,"Name":"Speed","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"FormatString":"0","Formula":{"Expression":"[DataPluginDemo.SimRIG.Vehicle.Speed]"},"Mode":2},"TextColor":{"Formula":