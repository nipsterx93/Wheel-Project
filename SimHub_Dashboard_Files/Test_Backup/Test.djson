calDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontSize":35.0,"Text":"WEATHER STATE","TextColor":"#FFB0C4DE","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":74.0,"Left":413.0,"Top":130.0,"Visible":true,"BlinkPhasisInverted":false,"Width":400.0,"Name":"WeatherState","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontWeight":"Medium","FontSize":70.0,"Text":"ASCIUTTO","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":74.0,"Left":415.0,"Top":60.0,"Visible":true,"BlinkPhasisInverted":false,"Width":400.0,"Name":"WeatherStateValue","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"Expression":"[DataPluginDemo.SimRIG.Session.WeatherAlert]"},"Mode":2},"TextColor":{"Formula":{"Expression":"if([SimRIG.Session.WeatherAlert] == 'ASCIUTTO', '#00E676', if([SimRIG.Session.WeatherAlert] == 'ALERT_PIOGGIA', '#FF9800', if([SimRIG.Session.WeatherAlert] == 'UMIDO', '#4FC3F7', '#00E676')))"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontSize":35.0,"Text":"TIME/LAPS TO RAIN","TextColor":"#FFB0C4DE","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":74.0,"Left":409.0,"Top":300.0,"Visible":true,"BlinkPhasisInverted":false,"Width":400.0,"Name":"TimeLapsToRain","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontWeight":"Medium","FontSize":70.0,"Text":"6.2","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":74.0,"Left":409.0,"Top":230.0,"Visible":true,"BlinkPhasisInverted":false,"Width":400.0,"Name":"TimeLapsToRainValue","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"Expression":"if(isnull([SimRIG.Session.WeatherAlert], '') == 'ALERT_PIOGGIA', \r\n   format(isnull([SimRIG.Session.TimeToImpactMinutes], 0), '0') + ' (' + format(isnull([SimRIG.Session.TimeToImpactLaps], 0.0), '0.0') + ')', \r\n   'NO RAIN'\r\n)"},"Mode":2},"TextColor":{"Formula":{"Expression":"if(isnull([SimRIG.Session.WeatherAlert], '') == 'ALERT_PIOGGIA', '#FF5252', if([SimRIG.Session.WeatherAlert] == 'UMIDO', '#FFEB3B', '#FFFFFF'))"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontSize":35.0,"Text":"SUGGESTED TIRES","TextColor":"#FFB0C4DE","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":74.0,"Left":413.0,"Top":467.0,"Visible":true,"BlinkPhasisInverted":false,"Width":400.0,"Name":"SuggestedTires","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"DINish","FontWeight":"Medium","FontSize":60.0,"Text":"SLICK","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":74.0,"Left":364.0,"Top":390.0,"Visible":true,"BlinkPhasisInverted":false,"Width":500.0,"Name":"SuggestedTiresVlue","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"Expression":"if(isnull([SimRIG.Session.CrossoverAlertState], 'NONE') == 'NONE', 'CURRENT IS OK', \r\n   if(isnull([SimRIG.Session.CrossoverAlertState], '') == 'BOX_WETS', 'BOX PER WET', \r\n      if(isnull([SimRIG.Session.CrossoverAlertState], '') == 'BOX_SLICKS', 'BOX FOR SLICKS', 'CURRENT IS OK')\r\n   )\r\n)"},"Mode":2},"TextColor":{"Formula":{"Expression":"if([SimRIG.Session.CrossoverAlertState] == 'NONE', '#00E676', \r\nif([SimRIG.Session.CrossoverAlertState] == 'BOX_WETS', '#2196F3', \r\nif([SimRIG.Session.CrossoverAlertState] == 'BOX_SLICK