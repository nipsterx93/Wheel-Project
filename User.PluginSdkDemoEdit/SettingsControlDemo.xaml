                                    <Grid Margin="0,0,0,10">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="80"/>

                                        </Grid.ColumnDefinitions>

                                        <ComboBox Name="CmbFlagSelector" Height="25" Margin="0,0,10,0">

