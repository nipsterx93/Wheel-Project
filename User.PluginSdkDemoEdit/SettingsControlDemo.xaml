                                            <ComboBoxItem Content="Blue Flag" Tag="Blue"/>

                                            <ComboBoxItem Content="Green Flag" Tag="Green"/>

                                        </ComboBox>

                                        <ToggleButton Name="BtnTestFlag" Grid.Column="1" Content="TEST" Style="{StaticResource ActiveToggleStyle}"/>

                                    </Grid>



                                    <StackPanel Name="PnlFlagControls">

                                        <TextBlock Text="ZONE A (PRIMARY)" Foreground="{StaticResource Brush_Accent}" FontSize="10" FontWeight="Bold"/>

                                        <Grid Margin="0,5">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="60"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Start LED:" Foreground="Gray" VerticalAlignment="Center"/>

                                            <TextBox Name="TxtFlagA_Start" Grid.Column="1" Background="#222" Foreground="White" TextAlignment="Center"/>

                                        </Grid>

                                        <Grid Margin="0,0,0,10">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="60"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Count:" Foreground="Gray" VerticalAlignment="Center"/>

                                            <TextBox Name="TxtFlagA_Count" Grid.Column="1" Background="#222" Foreground="White" TextAlignment="Center"/>

                                        </Grid>



                                        <CheckBox Name="ChkFlagB_Enable" Content="ENABLE ZONE B" Foreground="{StaticResource Brush_Accent}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>

                                        <StackPanel Name="PnlFlagZoneB">

                                            <Grid Margin="0,5">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="60"/>

                                                    <ColumnDefinition Width="*"/>

                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Start LED:" Foreground="Gray" VerticalAlignment="Center"/>

                                                <TextBox Name="TxtFlagB_Start" Grid.Column="1" Background="#222" Foreground="White" TextAlignment="Center"/>

                                            </Grid>

                                            <Grid Margin="0,0,0,10">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="60"/>

                                                    <ColumnDefinition Width="*"/>

                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Count:" Foreground="Gray" VerticalAlignment="Center"/>

                                                <TextBox Name="TxtFlagB_Count" Grid.Column="1" Background="#222" Foreground="White" TextAlignment="Center"/>

                                            </Grid>

                                        </StackPanel>



                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <CheckBox Name="ChkFlagBlink" Grid.Column="0" Content="BLINKING" Foreground="White" VerticalAlignment="Center"/>

                                            <StackPanel Name="PnlFlagBlinkRate" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">

                                                <TextBlock Text="Speed (ms): " Foreground="Gray" VerticalAlignment="Center"/>

                                                <TextBox Name="TxtFlagBlinkMs" Width="40" Background="#222" Foreground="White" TextAlignment="Center"/>

                                            </StackPanel>

                                        </Grid>

                                    </StackPanel>

                                </StackPanel>

                            </Expander>



                            <Expander Header="CAR SYSTEMS (ABS/TC)" IsExpanded="False">

                                <StackPanel>

                                    <Grid Margin="0,0,0,10">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="80"/>

                                        </Grid.ColumnDefinitions>

                                        <ComboBox Name="CmbCarSysSelector" Height="25" Margin="0,0,10,0">

                                            <ComboBoxItem Content="ABS Active" Tag="ABS"/>

                                            <ComboBoxItem Content="TC Active" Tag="TC"/>

                                            <ComboBoxItem Content="Pit Limiter" Tag="Pit"/>

                                        </ComboBox>

                                        <ToggleButton Name="BtnTestCar" Grid.Column="1" Content="TEST" Style="{StaticResource ActiveToggleStyle}"/>

                                    </Grid>



                                    <StackPanel Name="PnlCarSysControls">

                                        <TextBlock Text="ZONE A (PRIMARY)" Foreground="{StaticResource Brush_Accent}" FontSize="10" FontWeight="Bold"/>

                                        <Grid Margin="0,5">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="60"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Start LED:" Foreground="Gray" VerticalAlignment="Center"/>

                                            <TextBox Name="TxtCarA_Start" Grid.Column="1" Background="#222" Foreground="White" TextAlignment="Center"/>

                                        </Grid>

                                        <Grid Margin="0,0,0,10">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="60"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Count:" Foreground="Gray" VerticalAlignment="Center"/>

                                            <TextBox Name="TxtCarA_Count" Grid.Column="1" Background="#222" Foreground="White" TextAlignment="Center"/>

                                        </Grid>



                                        <CheckBox Name="ChkCarB_Enable" Content="ENABLE ZONE B" Foreground="{StaticResource Brush_Accent}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>

                                        <StackPanel Name="PnlCarZoneB">

                                            <Grid Margin="0,5">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="60"/>

                                                    <ColumnDefinition Width="*"/>

                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Start LED:" Foreground="Gray" VerticalAlignment="Center"/>

                                                <TextBox Name="TxtCarB_Start" Grid.Column="1" Background="#222" Foreground="White" TextAlignment="Center"/>

                                            </Grid>

                                            <Grid Margin="0,0,0,10">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="60"/>

                                                    <ColumnDefinition Width="*"/>

                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Count:" Foreground="Gray" VerticalAlignment="Center"/>

                                                <TextBox Name="TxtCarB_Count" Grid.Column="1" Background="#222" Foreground="White" TextAlignment="Center"/>

                                            </Grid>

                                        </StackPanel>



                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">

                                                <CheckBox Name="ChkCarBlink" Content="BLINKING" Foreground="White" Margin="0,0,0,5"/>

                                                <StackPanel Orientation="Horizontal">

                                                    <Button Name="BtnCarColor" Content="COLOR 1" Height="20" Width="50" Background="#333" Foreground="White" FontWeight="Bold" FontSize="9" Margin="0,0,5,0"/>

                                                    <Button Name="BtnCarColor2" Content="COLOR 2" Height="20" Width="50" Background="#333" Foreground="White" FontWeight="Bold" FontSize="9" Visibility="Collapsed"/>

                                                </StackPanel>

                                            </StackPanel>

                                            <StackPanel Name="PnlCarBlinkRate" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">

                                                <TextBlock Text="Speed (ms): " Foreground="Gray" VerticalAlignment="Center"/>

                                                <TextBox Name="TxtCarBlinkMs" Width="40" Background="#222" Foreground="White" TextAlignment="Center"/>

                                            </StackPanel>

                                        </Grid>

                                    </StackPanel>

                                </StackPanel>

                            </Expander>



                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </TabItem>



            <TabItem Header="DEBUG">

                <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <!-- Titolo e Spiegazione -->

                        <TextBlock Text="LOG MANAGER SETTINGS" FontWeight="Bold" FontSize="16" Foreground="#CF1020" Margin="0,0,0,10"/>

                        <TextBlock Text="Attiva gli interruttori per isolare e registrare i dati nel file CSV. Ricordati di disattivarli quando non fai debugging per mantenere i file puliti e ottimizzare le risorse." 

                                   TextWrapping="Wrap" Margin="0,0,0,15" Foreground="LightGray"/>



                        <!-- Contenitore delle Checkbox -->

                        <Border BorderBrush="#444" BorderThickness="1" Padding="15" CornerRadius="5" Background="#111">

                            <StackPanel>

                                <CheckBox x:Name="ChkLogSystem" Content="Abilita Log System (Inizializzazioni, caricamenti e stati generali del plugin)" Margin="0,5" Foreground="White"/>

                                <CheckBox x:Name="ChkLogFuel" Content="Abilita Log Fuel (Consumi sul giro, ricalcoli delta, step carburante)" Margin="0,5" Foreground="White"/>

                                <CheckBox x:Name="ChkLogStrategy" Content="Abilita Log Strategy (Passo giocatore, calcolo Undercut, gap dinamico)" Margin="0,5" Foreground="White"/>

                                <CheckBox x:Name="ChkLogRadar" Content="Abilita Log Pit Radar (Ingressi/Uscite pitlane, calibrazione fuel rate e gomme)" Margin="0,5" Foreground="White"/>

                                <CheckBox x:Name="ChkLogOpponents" Content="Abilita Log Opponents (Geofence pitlane, calcolo baseline e degrado avversari)" Margin="0,5" Foreground="White"/>

                                <CheckBox x:Name="ChkLogMicrosector" Content="Abilita Log Microsector (Fase 2: velocità medie best/drop, normalized times, diagnosi)" Margin="0,5" Foreground="White"/>

                                <CheckBox x:Name="ChkLogWeather" Content="Abilita Log Weather (Fase 3: umidità, pressione barometrica, stato IsTrackWet e previsioni)" Margin="0,5" Foreground="White"/>

                                <CheckBox x:Name="ChkLogHardware" Content="Abilita Log Hardware (Comandi input e seriali)" Margin="0,5" Foreground="White"/>

                                <CheckBox x:Name="ChkLogVoice" Content="Abilita Log Voice Engineer (Messaggi generati, chiavi vocali e parlato)" Margin="0,5" Foreground="White"/>

                                <CheckBox x:Name="ChkLogMergeGap" Content="Abilita Log MergeGap Monitor (File dedicato ogni 10s: distacco fisico, pit loss, gap target)" Margin="0,5" Foreground="White"/>

                            </StackPanel>

                        </Border>

                        <!-- Sezione Unit Testing e Validazione Strategia -->
                        <TextBlock Text="UNIT TESTING &amp; STRATEGY VALIDATION" FontWeight="Bold" FontSize="16" Foreground="#CF1020" Margin="0,20,0,10"/>

                        <Border BorderBrush="#444" BorderThickness="1" Padding="15" CornerRadius="5" Background="#111">
                            <StackPanel>
                                <TextBlock Text="Esegui istantaneamente la suite di test automatici C# per validare tutti i calcoli matematici di MergeGap, Pit Loss e strategie di gara." Foreground="LightGray" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnRunUnitTests" Content="ESEGUI UNIT TESTS STRATEGIA" Height="30" Padding="15,0" Background="#CF1020" Foreground="White" FontWeight="Bold" Click="BtnRunUnitTests_Click"/>
                                    <TextBlock x:Name="TxtUnitTestStatus" Text="" Foreground="#4CAF50" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>



                        <!-- Placeholder per il Live Overlay che abbiamo discusso -->

                        <TextBlock Text="LIVE DEBUG OVERLAY" FontWeight="Bold" FontSize="16" Foreground="#CF1020" Margin="0,25,0,10"/>

                        <Border BorderBrush="#444" BorderThickness="1" Padding="15" CornerRadius="5" Background="#050505">

                            <TextBlock Text="Questa sezione ospiterà i dati grezzi in tempo reale, per farti analizzare le variabili matematiche direttamente qui su SimHub mentre sei in pista." 

                                       Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap"/>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>



            <TabItem Header="WORKSHOP">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="20">

                        <TextBlock Text="SIMRIG WORKSHOP" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>



                        <Border Style="{StaticResource CardStyle}" BorderBrush="{StaticResource Brush_Error}" BorderThickness="1">

                            <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                                    <Ellipse Width="15" Height="15" Fill="{StaticResource Brush_Error}" Margin="0,0,10,0"/>

                                    <TextBlock Text="RISOLUZIONE PROBLEMI DI CONNESSIONE" Foreground="{StaticResource Brush_Error}" FontWeight="Bold" FontSize="16"/>

                                </StackPanel>

                                <TextBlock Text="Se i dispositivi risultano 'DISCONNECTED' o lo Scan fallisce:" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>

                                <TextBlock Text="1. Disabilita il plugin Arduino nativo di SimHub per queste porte." Foreground="{StaticResource Brush_TextMuted}" TextWrapping="Wrap"/>

                                <TextBlock Text="2. Chiudi Arduino IDE o altri software che usano le porte seriali." Foreground="{StaticResource Brush_TextMuted}" TextWrapping="Wrap"/>

                                <TextBlock Text="3. Premi nuovamente 'SCAN DEVICES' dopo qualche secondo." Foreground="{StaticResource Brush_TextMuted}" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            </StackPanel>

                        </Border>



                        <TextBlock Text="GUIDE &amp; CALIBRAZIONE" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,20,0,15"/>



                        <Expander Margin="0,0,0,10" Foreground="White">

                            <Expander.Header>

                                <TextBlock Text="Come Calibrare le Frizioni" Foreground="White" FontWeight="SemiBold"/>

                            </Expander.Header>

                            <StackPanel Margin="20,10,0,10">

                                <TextBlock Text="1. Ruota il Rotary Centrale sulla posizione 'Clutch Calibration'." Foreground="{StaticResource Brush_TextMuted}"/>

                                <TextBlock Text="2. Segui le istruzioni a schermo su SimHub." Foreground="{StaticResource Brush_TextMuted}"/>

                                <TextBlock Text="3. Premi a fondo e rilascia entrambe le leve." Foreground="{StaticResource Brush_TextMuted}"/>

                                <TextBlock Text="4. Premi SAVE sul volante." Foreground="{StaticResource Brush_TextMuted}"/>

                            </StackPanel>

                        </Expander>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>

            <TabItem Header="UNITS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="MEASUREMENT UNITS" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="DISPLAY PREFERENCES" Foreground="{StaticResource Brush_TextPrimary}" FontWeight="Bold" Margin="0,0,0,15"/>

                                <!-- Speed Unit -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Speed Unit" VerticalAlignment="Center" Foreground="{StaticResource Brush_TextMuted}"/>
                                    <ComboBox Grid.Column="1" Name="CmbSpeedUnit" Height="30">
                                        <ComboBoxItem Content="Kilometers per Hour (km/h)" Tag="kmh"/>
                                        <ComboBoxItem Content="Miles per Hour (mph)" Tag="mph"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Temperature Unit -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Temperature Unit" VerticalAlignment="Center" Foreground="{StaticResource Brush_TextMuted}"/>
                                    <ComboBox Grid.Column="1" Name="CmbTempUnit" Height="30">
                                        <ComboBoxItem Content="Celsius (°C)" Tag="C"/>
                                        <ComboBoxItem Content="Fahrenheit (°F)" Tag="F"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Pressure Unit -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Pressure Unit" VerticalAlignment="Center" Foreground="{StaticResource Brush_TextMuted}"/>
                                    <ComboBox Grid.Column="1" Name="CmbPressureUnit" Height="30">
                                        <ComboBoxItem Content="Bar (bar)" Tag="bar"/>
                                        <ComboBoxItem Content="Kilopascal (kPa)" Tag="kpa"/>
                                        <ComboBoxItem Content="Pounds per Square Inch (psi)" Tag="psi"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Warning Notice for In-Game Units Sync -->
                                <Border Background="#1F2A38" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,5,0,15">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠️ " FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="NOTA IMPORTANTE: Assicurati che l'unità di misura della pressione selezionata qui coincida con quella configurata nelle opzioni di iRacing / in-game per la corretta applicazione delle macro nei pit stop." 
                                                   TextWrapping="Wrap" Foreground="#E0E0E0" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

    </Grid>

</UserControl>

