{
  "permissions": {
    "allow": [
      "Bash(awk *)",
      "Bash(\"User.PluginSdkDemoEdit/User.PluginSdkDemo.Tests/bin/Debug/User.PluginSdkDemo.Tests.exe\")"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-lock.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
